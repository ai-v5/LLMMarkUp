{
  "name": "llmmarkup",
  "version": "0.7.1",
  "private": true,
  "description": "简洁、顺手的 Windows Markdown 编辑器，支持文件树、多标签、实时预览与 LaTeX 公式。A simple, easy-to-use Markdown editor for Windows.",
  "author": "LLMMarkUp contributors",
  "license": "AGPL-3.0-only",
  "main": "main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test --test-concurrency=1 tests/*.test.*",
    "test:e2e": "npm run build && node --test tests/e2e.cjs",
    "pack": "npm run build && node scripts/build-launcher.cjs && electron-builder --win dir --x64 --publish never",
    "dist": "npm run build && node scripts/build-launcher.cjs && electron-builder --win nsis --x64 --publish never",
    "dist:local": "npm run dist && powershell -NoProfile -ExecutionPolicy Bypass -File install-local.ps1 -Launch"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@mdit/plugin-footnote": "1.1.3",
    "@mdit/plugin-katex": "1.1.4",
    "@mdit/plugin-tasklist": "1.1.4",
    "@playwright/test": "1.64.1",
    "codemirror": "6.0.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "katex": "0.19.1",
    "markdown-it": "15.0.3"
  },
  "build": {
    "afterSign": "scripts/after-sign.cjs",
    "appId": "io.ai-v5.llmmarkup",
    "productName": "LLMMarkUp",
    "asar": true,
    "directories": {
      "output": "outputs/installers"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "workspace.cjs",
      "session.cjs",
      "dist/**",
      "package.json",
      "assets/studio.ico",
      "LICENSE",
      "NOTICE",
      "licenses/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/studio.ico",
      "signExecutable": false
    },
    "nsis": {
      "include": "installer.nsh",
      "script": "scripts/installer.nsi",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "LLMMarkUp-${version}-Setup.${ext}",
      "installerIcon": "assets/studio.ico",
      "uninstallerIcon": "assets/studio.ico",
      "guid": "7cc4e431-bb58-5499-952a-e3ae1c4abe51",
      "license": "LICENSE"
    },
    "extraFiles": [
      {
        "from": "outputs/launcher-build/llmmarkup-launcher.exe",
        "to": "llmmarkup-launcher.exe"
      }
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "dist/THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "licenses",
        "to": "licenses"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-v5/LLMMarkUp.git"
  },
  "homepage": "https://ai-v5.github.io/LLMMarkUp/",
  "bugs": {
    "url": "https://github.com/ai-v5/LLMMarkUp/issues"
  }
}
